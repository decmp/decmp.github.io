---
// The decmp logo (same mark as decmp.dev) followed by "decmp" with its blinking cursor, then "learn".
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="mark" aria-hidden="true">
		<svg viewBox="0 0 16 16" width="16" height="16">
			<path
				d="M5.5 5 3.5 8l2 3M10.5 5l2 3-2 3"
				fill="none"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
			<circle cx="8" cy="8" r="1"></circle>
		</svg>
	</span>
	<span class="word">decmp<span class="decmp-cursor" aria-hidden="true"></span></span>
	<span class="sub">learn</span>
	<span class="sr-only">decmp Learn</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.mark {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0.375rem;
		background: #18181b;
	}
	.mark path {
		stroke: #f4f4f5;
	}
	.mark circle {
		fill: #34d399;
	}
	:global([data-theme='light']) .mark {
		background: #18181b;
	}
	.word {
		display: flex;
		align-items: center;
		font-family: var(--sl-font-mono);
		font-size: 15px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.decmp-cursor {
		display: inline-block;
		width: 6px;
		height: 12px;
		margin-inline-start: 2px;
		transform: translateY(1px);
		background: var(--sl-color-gray-4);
		animation: decmp-blink 1.1s steps(1, end) infinite;
	}
	.sub {
		font-family: var(--sl-font-mono);
		font-size: 15px;
		color: var(--sl-color-gray-3);
		padding-inline-start: 0.5rem;
		border-inline-start: 1px solid var(--sl-color-hairline);
	}
</style>
