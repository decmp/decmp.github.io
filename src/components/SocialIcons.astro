---
// Header: a link back to decmp.dev, then the repository of this site.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const label = Astro.locals.t('decmp.backLink');
---

<a class="back" href="https://decmp.dev"
	>{label}
	<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"
		><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
		></path></svg
	></a
>
<a class="repo" href="https://github.com/decmp/decmp.github.io" aria-label="GitHub">
	<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"
		><path
			d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
		></path></svg
	>
</a>
<Default />

<style>
	a {
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.back {
		gap: 0.25rem;
		font-size: 13px;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		padding: 0.375rem 0.625rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		white-space: nowrap;
	}
	.back:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.repo {
		color: var(--sl-color-gray-3);
		padding: 0.5em;
		margin: -0.5em 0;
	}
	.repo:hover {
		color: var(--sl-color-white);
	}
</style>
